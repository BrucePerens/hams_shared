# Claude Code agent worktrees -- created locally per-session for isolated
# subagent dispatches (Agent tool, isolation: "worktree"), never meant to be
# committed; a stray one otherwise shows up as untracked noise in every
# `git status` for the rest of the session.
.claude/worktrees/

# Internationalization
i18n/hams_master.pot

# Python / Bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.venv/

# Environment Variables / Secrets
.env

# IDEs / Editors
.vscode/
.idea/

# OS Generated
.DS_Store
Thumbs.db

# Odoo Local Dev
*.log
filestore/
sessions/

# Custom Tooling Workspaces
task_workspace_*/
*.patch
*.bak
*.tmp

# Node (ESLint config's own devDependencies -- see package.json)
node_modules/
