# System unit (User=root: the reaper runs `sudo -n -u postgres`), so `%h` would be /root and cannot name the
# checkout. The path is a placeholder that the install command substitutes, so the unit works for any user and home:
#   sed "s|@HAMS_SHARED_TOOLS@|$HOME/workspace/hams_open/hams_shared/tools|" reap-stale-test-databases.service \
#     | sudo tee /etc/systemd/system/reap-stale-test-databases.service >/dev/null
#   sudo install -m 644 reap-stale-test-databases.timer /etc/systemd/system/ && sudo systemctl daemon-reload
# An unsubstituted copy fails to start (no such directory) rather than running the wrong path.
[Unit]
Description=Reap stale tmp_-prefixed scoped-test PostgreSQL databases (dev box only)
After=postgresql.service

[Service]
Type=oneshot
# A oneshot has no start timeout. The timer re-arms from the last activation (OnUnitActiveSec), so a hung run would silently stop every later reap.
TimeoutStartSec=1h
User=root
WorkingDirectory=@HAMS_SHARED_TOOLS@
ExecStart=/usr/bin/env python3 reap_stale_test_databases.py
