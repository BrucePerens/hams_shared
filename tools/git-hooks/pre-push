#!/usr/bin/env bash
# ADR-0102: client-side early warning for a non-fast-forward push to main, backed by (not a
# substitute for) server-side branch protection (enforce_admins: true, allow_force_pushes: false).
# A session can edit or delete this hook; it cannot edit GitHub's own rules. This just fails fast
# and locally, before spending a network round trip on a push the server would reject anyway.
#
# Installed by ../install_git_hooks.sh into .git/hooks/pre-push, which every worktree of a repo
# shares (hooks live in the common .git directory, not per-worktree) -- install once per repo.

set -euo pipefail

remote_name="$1"
protected_ref="refs/heads/main"
zero_sha="0000000000000000000000000000000000000000"

# stdin (one "local_ref local_sha remote_ref remote_sha" line per ref being pushed) can only be
# read once -- buffered into an array so both passes below can use it, instead of the original
# single `while read` loop that only ever served the main fast-forward check.
updates=()
while IFS= read -r line; do
    updates+=("$line")
done

# NO DIRECT PUSHES TO MAIN (2026-11-23): first check, before any network call. merge_pr.py and merge_all.sh merge through the GitHub API.
# hams_open and hams_shared: refused outright. hams_com: pre_push_check.py below allows only to-do notes (devbox_tools/todo_note.py).
# HAMS_ALLOW_MAIN_PUSH=1 (set by hand by the coordinator; no tool sets it) lets anything through.
origin_url=$(git remote get-url "$remote_name" 2>/dev/null || true)
for line in "${updates[@]}"; do
    read -r _ _ remote_ref _ <<< "$line"
    if [ "$remote_ref" = "$protected_ref" ] && [ "${HAMS_ALLOW_MAIN_PUSH:-}" != "1" ] && [ "$(basename "$origin_url" .git)" != "hams_com" ]; then
        echo "pre-push: NO DIRECT PUSHES TO MAIN: open a PR and merge with devbox_tools/merge_pr.py" >&2
        exit 1
    fi
done

for line in "${updates[@]}"; do
    read -r local_ref local_sha remote_ref remote_sha <<< "$line"
    [ "$remote_ref" = "$protected_ref" ] || continue

    # Deleting the branch: local_sha is all zeros. Never allowed for main; branch protection
    # (allow_deletions: false) already refuses this server-side, but fail fast locally too.
    if [ "$local_sha" = "$zero_sha" ]; then
        echo "pre-push: refusing to delete $protected_ref" >&2
        exit 1
    fi

    # Branch doesn't exist on the remote yet: nothing to fast-forward against.
    if [ "$remote_sha" = "$zero_sha" ]; then
        continue
    fi

    git fetch -q "$remote_name" "${protected_ref#refs/heads/}"
    current_remote_sha=$(git rev-parse "$remote_name/${protected_ref#refs/heads/}")

    if ! git merge-base --is-ancestor "$current_remote_sha" "$local_sha"; then
        cat >&2 <<EOF
pre-push: refusing a non-fast-forward push to $protected_ref.

$remote_name/${protected_ref#refs/heads/} has moved to $current_remote_sha since your branch was
built on $remote_sha -- a peer likely pushed in the meantime. Fetch and rebase/merge before
pushing again. This is never solved by --force: main also refuses force pushes server-side.
EOF
        exit 1
    fi
done

# merge_pr discipline (2026-11-16): refuse a direct push of code to main (only to-do notes may go direct), and on any other
# branch run merge_pr's cheap checks within about 3 minutes (a slow check only warns). Logic and limits: tools/pre_push_check.py.
# Skipped, with a warning, when the helper cannot be found (a worktree before fix_worktree_symlinks.py).
# Git runs a hook with GIT_DIR (in a linked worktree: the worktree's own git dir) in the environment. The checks below run tests that
# `git init` / `git commit` in temp directories; with GIT_DIR inherited they acted on THIS repository instead: commits "init"/"seed" landed
# on the pushed branch and `git init` wrote core.bare=true into the shared .git/config (2026-11-16, broke merge_pr.py). Drop the variables.
unset $(git rev-parse --local-env-vars)
root=$(git rev-parse --show-toplevel)
common=$(cd "$root" && cd "$(git rev-parse --git-common-dir)" && pwd)
helper=""
for base in "$root" "$(dirname "$common")"; do
    for sub in hams_shared/tools tools; do
        if [ -f "$base/$sub/pre_push_check.py" ]; then helper="$base/$sub/pre_push_check.py"; break 2; fi
    done
done
if [ -z "$helper" ]; then
    echo "pre-push: pre_push_check.py not found; merge_pr check skipped." >&2
else
    for line in "${updates[@]}"; do
        read -r local_ref local_sha remote_ref remote_sha <<< "$line"
        python3 "$helper" "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" || exit 1
    done
fi

# The 2026-09-28 pre-push check_burn_list.py gate was removed 2026-10-02 at Bruce's direction:
# ~20 concurrent whole-repo scans overloaded the dev box during bulk to-do processing, and the
# coordinating session runs its own lint/test passes. The burn-list CI workflow was removed the
# same day (hams_shared #75, hams_com #553); see ADR 0102's 2026-10-02 addendum.

exit 0
